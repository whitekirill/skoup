---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/base.css';
import Seo, { type Breadcrumb } from '../components/Seo.astro';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  article?: { published: string; modified: string; section: string; headline: string; image?: string };
  breadcrumbs?: Breadcrumb[];
  noindex?: boolean;
}

const props = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <Seo {...props} />

    <link rel="preload" href="/fonts/manrope-cyrillic-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <!-- латиница Manrope — цифры и «UX» в крупном тексте; без предзагрузки подмена шрифта сдвигает строки -->
    <link rel="preload" href="/fonts/manrope-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono-cyrillic-500-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="page">
      <slot />
    </div>
    <script>
      import '../scripts/smooth-scroll';
      import '../scripts/scrollbar';
    </script>
  </body>
</html>
