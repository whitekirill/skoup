---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Cases from '../components/Cases.astro';
import Formats from '../components/Formats.astro';
import About from '../components/About.astro';
import Blog from '../components/Blog.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
---

<Base
  title="Скоуп — продуктовая дизайн-студия для финтеха"
  description="Проектируем финтех, который проходит проверку регулятора, с AI на каждом этапе: стратегия, интерфейсы, регуляторика, аналитика и аудит."
>
  <Header />
  <main>
    <Hero />
    <Services />
    <Cases />
    <Formats />
    <About />
    <Blog />
  </main>
  <Footer />
  <StickyCta />
</Base>
