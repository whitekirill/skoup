---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Services from '../components/home/Services.astro';
import Cases from '../components/home/Cases.astro';
import Formats from '../components/home/Formats.astro';
import About from '../components/home/About.astro';
import Blog from '../components/home/Blog.astro';
import Cta from '../components/home/Cta.astro';
import Brief from '../components/brief/Brief.astro';
---

<Base
  title="Скоуп — дизайн-студия финтех-продуктов и банков"
  description="Проектируем банковские и финтех-продукты, которые проходят проверку регулятора: стратегия, интерфейсы, регуляторика, UX-исследования и аудит."
  image="/og/home.png"
  imageAlt="Скоуп — продуктовая дизайн-студия для финтеха"
>
  <main>
    <Hero />
    <Services />
    <Cases />
    <Formats />
    <About />
    <Blog />
    <Cta />
  </main>
  <Brief />
</Base>
