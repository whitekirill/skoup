---
/**
 * Статья «Покупка частями в кредит на Ozon, Wildberries и Яндекс Маркете» (Figma: desktop 598:7137, mobile 633:7943).
 * Колонка текста 688 (поля layout/article-padding), иллюстрации 1024, секции чередуют surface/primary и surface/tertiary.
 * Внизу — финальный CTA и галерея, как на главной. Навигация по статье — ArticleNav.
 */
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Button from '../../components/Button.astro';
import Cta from '../../components/home/Cta.astro';
import Brief from '../../components/brief/Brief.astro';
import ArticleFigure from '../../components/article/ArticleFigure.astro';
import Note from '../../components/article/Note.astro';
import SummaryTable from '../../components/article/SummaryTable.astro';
import ArticleNav from '../../components/article/ArticleNav.astro';
import { CTA } from '../../data/site';
import { ARTICLE_MARKETPLACES as META } from '../../data/seo';
import ozon from '../../assets/article/logos/ozon.svg?url';
import wb from '../../assets/article/logos/wb.svg?url';
import ym from '../../assets/article/logos/ym.svg?url';

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/article/img/*.png', { eager: true });
const img = (name: string) => files[`../../assets/article/img/${name}.png`].default;
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

const hero = img('00-hero');
const heroSet = async (format: 'avif' | 'webp') => {
  const [a, b] = await Promise.all([1, 2].map((d) => getImage({ src: hero, width: 688 * d, format })));
  return `${a.src} 688w, ${b.src} 1376w`;
};
const [heroAvif, heroWebp] = await Promise.all([heroSet('avif'), heroSet('webp')]);
const heroFallback = await getImage({ src: hero, width: 688, format: 'webp' });

const NAV = [
  { id: 'intro', label: 'Введение' },
  { id: 'entry', label: 'Точка входа' },
  { id: 'limit', label: 'Оформление лимита' },
  { id: 'purchase', label: 'Покупка' },
  { id: 'transfer', label: 'Деньги на карту' },
  { id: 'findings', label: 'Находки' },
];
---

<Base
  title="Покупка частями в кредит на Ozon, Wildberries и Яндекс Маркете — Скоуп"
  description="Прошли путь покупки частями на трёх маркетплейсах: где предлагают кредит, как оформляют лимит, что видно после покупки и что говорит закон."
  type="article"
  image={META.ogImage}
  imageAlt={META.ogImageAlt}
  article={{ published: META.published, modified: META.modified, section: META.section, headline: META.headline, image: new URL(heroFallback.src, Astro.site).href }}
  breadcrumbs={[{ name: 'Главная', path: '/' }, { name: 'Покупка частями в кредит на Ozon, Wildberries и Яндекс Маркете', path: META.path }]}
  preloadFonts={["geist-mono-latin-500-normal.woff2"]}
>
  <main class="article">
    <!-- Первый экран: крошки, заголовок, иллюстрация -->
    <header class="art-hero art-section art-section--primary">
      <div class="art-hero__head">
        <nav class="crumbs t-button-s" aria-label="Хлебные крошки">
          <ol>
            <li><a href="/">Главная</a></li>
            <li aria-current="page"><span>Покупка частями в кредит на ozon, wildberries</span></li>
          </ol>
        </nav>
        <h1 class="t-h3" data-vt-title>Покупка частями в кредит<br /><span class="muted">на Ozon, Wildberries и Яндекс Маркете: как это выглядит и что говорит закон</span></h1>
      </div>
      <picture class="art-hero__image">
        <source type="image/avif" srcset={heroAvif} sizes="(max-width: 767px) 100vw, 688px" />
        <source type="image/webp" srcset={heroWebp} sizes="(max-width: 767px) 100vw, 688px" />
        <img src={heroFallback.src} alt="Покупка частями: первый платёж 0 ₽ сегодня, дальше по 750 ₽ раз в месяц" width="688" height="387" fetchpriority="high" />
      </picture>
    </header>

    <!-- Введение -->
    <section class="art-section art-section--tertiary" id="intro" aria-label="Введение">
      <div class="prose t-body-m">
        <p>Оплатить частями сейчас можно на любом крупном маркетплейсе. Кнопка стоит прямо в карточке товара, рядом с ценой, либо в выборе способов оплаты в чекауте.</p>
        <p>За этой кнопкой стоят финансовые компании самих площадок: у Ozon — Ozon Банк и МКК «Озон Кредит», у Wildberries — ВБ Банк и МКК «ВБ Платежные технологии», у Яндекса — Яндекс Банк. Маркетплейсы давно продают не только товары, но и деньги в долг.</p>
        <p>«Частями» бывает разным. Бесплатная рассрочка — это ровно цена товара и срок до шести месяцев. Кредит или заём — это проценты сверху и запись в кредитной истории. Здесь мы сравниваем только второе: продукт, который открывает кредитный лимит на покупки. На каждой площадке он свой, но устроен похоже.</p>
        <p>Такие продукты регулирует закон о потребительском кредите. А законы о персональных данных и о платёжной системе касаются всех.</p>
        <p>Мы прошли путь сами — от кнопки в карточке товара до денег на карте с открытого лимита, со старыми аккаунтами и с новыми. Дошли не везде: где-то заявку отклонили, где-то остановили на проверке. Поэтому в некоторых сравнениях не все площадки. Ниже четыре этапа пути, без оценок. В конце — идеи и находки.</p>
      </div>
      <div class="products">
        <ul class="products__list t-body-s">
          <li><img src={ozon} alt="Ozon" width="48" height="48" loading="lazy" /><p>«Рассрочка» — заём с лимитом от ООО МКК «Озон Кредит». Срок — 6, 12 или 24 месяца, сверху — «доплата».</p></li>
          <li><img src={wb} alt="Wildberries" width="48" height="48" loading="lazy" /><p>«Частями Плюс» — заём с лимитом до 100 000 ₽ от ООО МКК «ВБ Платежные технологии», срок до 12 месяцев. Бесплатный «Частями» — другой продукт: его показываем только там, где до «Частями Плюс» мы не дошли, и пишем об этом.</p></li>
          <li><img src={ym} alt="Яндекс Маркет" width="48" height="48" loading="lazy" /><p>«Супер Сплит» — кредит с лимитом от Яндекс Банка, срок от 2 до 24 месяцев. За покупки на 2 месяца проценты не начисляют, на 4–24 месяца — начисляют.</p></li>
        </ul>
        <p class="products__info t-body-s">
          <Icon name="text-i-circle" />
          <span>На Ozon и Яндексе у нас были старые аккаунты с открытыми лимитами,<br class="br-desktop" /> а 27–28 октября мы попробовали ещё и с новых. С новых аккаунтов лимит<br class="br-desktop" /> не открыли ни на одной площадке. Поэтому шаги после одобрения<br class="br-desktop" /> мы показываем по старым аккаунтам, а на WB до них не дошли.</span>
        </p>
      </div>
    </section>

    <!-- 1. Точка входа -->
    <section class="art-section art-section--primary" id="entry" aria-labelledby="entry-title">
      <div class="stack t-body-m">
        <h2 class="t-h3" id="entry-title">Точка входа: где предлагают оплатить частями</h2>
        <p>Покупатель видит предложение оплатить частями дважды: в карточке товара и в оформлении заказа (в чекауте). Посмотрим, как это выглядит на каждой площадке.</p>
      </div>
      <ArticleFigure src={img('01-entry-card')} alt="Точка входа: карточка товара на Ozon, Wildberries и Яндекс Маркете" />
      <div class="stack t-body-m">
        <p>Все три площадки ставят предложение прямо под ценой. Яндекс показывает превью графика платежей и даёт на выбор два срока. WB показывает сумму платежа и его количество. Ozon сразу пишет “Без переплат” и показывает возможные сроки.  Слов «заём» или «кредит» на этих плашках нет — они появляются дальше, в условиях и документах.</p>
      </div>
      <ArticleFigure src={img('02-entry-checkout')} alt="Точка входа: чекаут на Ozon, Wildberries и Яндекс Маркете" />
      <div class="stack t-body-m">
        <p>Свои продукты площадки поощряют скидкой, и это видно прямо в выборе способа оплаты. На Ozon за оплату Ozon Банком, кредиткой или «Рассрочкой» скидывают 662 ₽ — около 6% от цены заказа. На WB за оплату кошельком — 5 427 ₽, это 7%. На Яндексе за карту Пэй — 945 ₽, или 3%.</p>
        <p>Прямо в чекауте можно выбрать срок и заранее посмотреть график: сколько платить и когда. Каждая площадка показывает его по-своему.</p>
      </div>
      <ArticleFigure src={img('03-term')} alt="Выбор срока на Ozon, Wildberries и Яндекс Маркете" />
      <div class="stack t-body-m">
        <p>Ozon переплату называет доплатой и пишет её в одном месте. Яндекс называет переплатой и пишет её у каждого срока, показывая всё на одном экране. WB в нашем заказе показал один график: 8 платежей за 4 месяца с переплатой 4 722 ₽ в месяц.</p>
      </div>
      <div class="stack t-body-m">
        <h3 class="t-h5">Рассрочка, заём и кредит — в чём разница</h3>
        <p><b>Рассрочка</b><br />Платишь ровно цену товара, без процентов и не дольше шести месяцев. Это не кредит: сервису рассрочки платит магазин.</p>
        <p><b>Заём</b><br />Деньги в долг от МФО или МКК — с процентами, договором и проверкой кредитной истории. Так устроены «Рассрочка» Ozon и «Частями Плюс» WB.</p>
        <p><b>Кредит</b><br />То же самое, что и заём, только деньги даёт банк. Так устроен «Супер Сплит» Яндекса.</p>
        <p>Магазину рассрочка выгоднее: деньги он получает сразу, а «без переплаты» продаёт лучше процентов.</p>
      </div>
      <Note law="283-ФЗ «О деятельности по предоставлению сервиса рассрочки», ст. 2, 3, 13, 14 · Закон «О защите прав потребителей», ст. 16.1 п. 4.1">
        <p>Бесплатная рассрочка — это когда клиент платит ровно цену товара, срок не больше 6 месяцев и сверху ничего не берут. Давать её могут только операторы из реестра Банка России. Продавцу закон запрещает ставить разные цены на один товар в зависимости от того, платит ли клиент через сервис рассрочки, в рассрочку или с отсрочкой. Кредит или заём от банка или МКК для магазина — это оплата сразу и целиком, поэтому скидки за свой кредит или свою карту под этот запрет прямо не попадают. Отдельной нормы о том, как называть кредит на витрине, в законе нет. Но в сентябре 2026 года Банк России заявил, что будет бороться с кредитами под видом рассрочки.</p>
      </Note>
    </section>

    <!-- 2. Оформление лимита -->
    <section class="art-section art-section--tertiary" id="limit" aria-labelledby="limit-title">
      <div class="stack t-body-m">
        <h2 class="t-h3" id="limit-title">Оформление лимита</h2>
        <p>Следующий шаг — оформить лимит.</p>
      </div>
      <div class="stack t-body-m">
        <p><b>Что такое лимит</b><br />Это сумма, которую банк или МКК готовы дать клиенту в долг. Лимит открывают один раз, а потом платят им за покупки: купил — свободная сумма уменьшилась, внёс платёж — снова выросла. Новой заявки и нового договора для каждой покупки не нужно, главное — не выйти за лимит.</p>
        <p>Чтобы открыть лимит, площадка спрашивает доход клиента и желаемую сумму, берёт согласия, проверяет личность и кредитную историю, а потом даёт подписать договор.</p>
      </div>
      <ArticleFigure src={img('04-limit')} alt="Выбор суммы лимита на Ozon и Wildberries" />
      <div class="stack t-body-m">
        <p><b>Ozon</b><br />В «Рассрочке» желаемый лимит клиент вводит сам — до 500 000 ₽.</p>
        <p><b>WB</b><br />Скрин — из WB Кэш: это немного другой продукт, кредитный лимит ВБ Банка, но выбор суммы там устроен так же.</p>
        <div class="prose">
          <p><b>Период охлаждения</b><br />С 1 сентября 2025 года по закону о потребительском кредите деньги по кредиту от 50 000 до 200 000 ₽ выдают не раньше чем через 4 часа после подписания договора, а по кредиту больше 200 000 ₽ — не раньше чем через 48 часов. За это время клиент может передумать и отказаться. Если кредит меньше 50 000 ₽, паузы нет. Не действует она и для ипотеки, автокредита, образовательного кредита и рефинансирования без увеличения долга.</p>
          <p>WB показывает паузу прямо на экране выбора суммы: при лимите 100 000 ₽ сразу доступны 49 000 ₽, а остальные 51 000 ₽ — через 4 часа. На экране Ozon о паузе ничего нет: сумма в поле — только заявка, итоговый лимит банк назначает после проверки.</p>
        </div>
        <p>Пока клиент оформляет лимит, площадка просит его согласиться с несколькими документами: на обработку персональных данных, на запрос в бюро кредитных историй, на простую электронную подпись. Сначала — согласия внутри приложения.</p>
      </div>
      <ArticleFigure src={img('05-consents')} alt="Согласия при оформлении лимита на Ozon, Wildberries и Яндекс Маркете" />
      <div class="stack t-body-m">
        <p><b>Ozon</b><br />Согласие — строка под кнопкой: нажал «Рассчитать мой лимит» — значит, согласился на кредитный отчёт.</p>
        <p><b>WB</b><br />Согласия вынесены в отдельные галочки, но отмечены заранее: запрос в бюро кредитных историй и заявление на заём. Есть и исключение: перед переходом на Госуслуги WB просит согласиться с договором и обработкой данных, и эту галочку клиент ставит сам.</p>
        <p><b>Яндекс Маркет</b><br />Тоже отдельные галочки, и тоже отмечены заранее: обработка данных и простая электронная подпись.</p>
      </div>
      <ArticleFigure src={img('06-consents-gosuslugi')} alt="Согласия на Госуслугах для Ozon, Wildberries и Яндекс Маркета" />
      <div class="stack t-body-m">
        <p>На Госуслугах согласие — всегда отдельный экран: кто просит данные, зачем, на какой срок, и кнопка «Предоставить» с возможностью отклонить.</p>
        <p><b>Ozon</b><br />Озон Банк просит данные, чтобы выдать кредит или заём и выпустить карту, а в «Действиях с данными» сказано, что обрабатывать их будет МКК «Озон Кредит».</p>
        <p><b>WB</b><br />ВБ Банку данные нужны, чтобы подтвердить личность для кошелька: без этого в нём по закону можно держать не больше 15 000 ₽.</p>
        <p><b>Яндекс Маркет</b><br />Яндекс Банк пишет цель «выпуск и обслуживание кредитной карты»: Супер Сплит — это кредитка.</p>
        <p>Перед решением банк смотрит кредитную историю клиента: какие у него кредиты, сколько он платит каждый месяц, были ли просрочки и отказы. Заглянуть в неё банк может только с согласия клиента, и действует оно полгода.</p>
        <p>По этим платежам и доходу банк считает долговую нагрузку — какую часть дохода уже забирают кредиты. Это обязательно для любого кредита, а рассрочки без процентов не касается. Жёсткого потолка в законе нет: если нагрузка выше 50%, банк только письменно предупреждает клиента. Но много таких кредитов выдавать не даёт Банк России, а клиентам с нагрузкой выше 80% кредитные лимиты с октября 2026 года не открывают совсем.</p>
      </div>
      <ArticleFigure src={img('07-credit-history')} alt="Запрос кредитной истории на Ozon, Wildberries и Яндекс Маркете" />
      <div class="stack t-body-m">
        <p><b>Ozon</b><br />Отдельного кода нет: согласие на кредитный отчёт — строка под кнопкой «Рассчитать мой лимит» на экране выбора ежемесячного дохода. Нажал — значит, согласился.</p>
        <p><b>WB</b><br />Просит на это согласие отдельный код из СМС. К нам он так и не пришёл.</p>
        <p><b>Яндекс Маркет</b><br />Тоже просит отдельный код из СМС.</p>
      </div>
      <ArticleFigure src={img('08-contract-link')} alt="Где открыть договор на Ozon, Wildberries и Яндекс Маркете" />
      <div class="stack t-body-m">
        <p>До договора клиент добирается по ссылке в тексте.</p>
        <p><b>Ozon</b><br />Это слово «договор» в строке под кнопкой «Подписать договор».</p>
        <p><b>WB</b><br />Документы открываются по строкам списка на подпись, а у займа — по ссылке «заявление на заём» в галочке анкеты.</p>
        <p><b>Яндекс Маркет</b><br />Договор открылся по ссылке «кредитного договора» в ответах на вопросы.</p>
        <p>Отдельной кнопки «Открыть договор» мы не видели ни у кого. Закон её и не требует: он задаёт, как должен выглядеть сам договор.</p>
        <p>Сам договор потребительского кредита закон описывает подробно. Первая страница начинается с полной стоимости кредита — в процентах годовых и в рублях. Она стоит в двух квадратных рамках в правом верхнем углу: каждая не меньше 5% площади страницы, цифры чёрные на белом и самым крупным шрифтом на странице. Ниже — таблица индивидуальных условий по форме Банка России: сумма или лимит, срок, ставка, количество и размер платежей.</p>
      </div>
      <ArticleFigure src={img('09-contract')} alt="Первая страница договора: полная стоимость кредита в рамках и таблица условий" />
      <div class="stack t-body-m">
        <p>Подписывают договор кодом из СМС.</p>
        <p><b>Ozon</b><br />Первая страница устроена так, как требует закон: полная стоимость — в рамках вверху, ниже — таблица условий.</p>
        <p><b>WB</b><br />До подписи мы не дошли: оформление остановилось раньше.</p>
        <p><b>Яндекс Маркет</b><br />Всё как у Ozon: рамки с полной стоимостью вверху и таблица условий ниже.</p>
        <p>На экранах оформления этих цифр нет — они есть только в самом документе.</p>
        <p>После подписания лимит появляется в приложении. Там видно, сколько осталось, и оттуда же им управляют: переводят деньги на карту, открывают график и вносят платежи.</p>
      </div>
      <ArticleFigure src={img('10-limit-in-app')} alt="Открытый лимит в приложениях Ozon Банка, Wildberries и Яндекс Маркета" />
      <div class="stack t-body-m">
        <p><b>Ozon</b><br />«Рассрочка» — на главной Ozon Банка, рядом с кредиткой.</p>
        <p><b>WB</b><br />Лимит — в профиле: «100 000 ₽ — лимит на оплату частями». Это лимит бесплатного «Частями»: «Частями Плюс» нам не открыли.</p>
        <p><b>Яндекс Маркет</b><br />Отдельная карта Сплита с остатком лимита.</p>
      </div>
      <Note law="152-ФЗ «О персональных данных», ст. 9 ч. 1 · 161-ФЗ «О национальной платёжной системе», ст. 10 · 353-ФЗ «О потребительском кредите (займе)», ст. 5 ч. 12, ст. 6 ч. 1, ст. 7 ч. 9.3 · 218-ФЗ «О кредитных историях», ст. 4, ст. 6 ч. 9–10 · 353-ФЗ, ст. 5.1">
        <p>Согласие на обработку данных оформляют отдельно от других документов. В кошельке без подтверждённой личности можно держать до 15 000 ₽. Полную стоимость кредита печатают в рамке на первой странице договора. Если кредит от 50 000 до 200 000 ₽, деньги выдают не раньше чем через 4 часа после подписания, если больше — через 48 часов. Кредитный отчёт банк получает только с согласия клиента, и оно действует 6 месяцев. Перед выдачей кредита кредитор обязан посчитать долговую нагрузку клиента.</p>
