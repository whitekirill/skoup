---
/**
 * Всплывающая шапка статьи (Figma 746:12778): полоса во всю ширину, в колонке 688 — хлебные крошки,
 * чтобы с любого места статьи вернуться на главную. Desktop 84 (поля 32), mobile — поля страницы.
 * Поведение (src/scripts/article-head.ts): на первом экране статьи не показывается совсем; ниже —
 * появляется при скролле вверх и уезжает при скролле вниз. Фон — стекло (варианты ниже, data-glass).
 */
import Crumbs from './Crumbs.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const WEBKIT = '-webkit-backdrop-filter: var(--glass-blur, none)';
---

<div class="art-head is-hidden" data-art-head data-glass="progressive" inert>
  {/* -webkit-backdrop-filter (Safari до 18) — в атрибуте: из CSS сборка его выбрасывает */}
  <div class="art-head__glass" aria-hidden="true" style={WEBKIT}>
    <span style={WEBKIT}></span><span style={WEBKIT}></span><span style={WEBKIT}></span><span style={WEBKIT}></span>
  </div>
  <div class="art-head__inner">
    <Crumbs title={title} label="Хлебные крошки, шапка" />
  </div>
</div>

<script>
  import { mountArticleHead } from '../../scripts/article-head';
  const root = document.querySelector<HTMLElement>('[data-art-head]');
  if (root) mountArticleHead(root);
</script>

<style>
  .art-head {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    padding: var(--space-32) var(--layout-page-padding);
    transition:
      translate 400ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .art-head.is-hidden {
    translate: 0 -100%;
    opacity: 0;
  }

  .art-head__inner {
    position: relative;
    max-width: var(--layout-column-width);
    margin-inline: auto;
  }

  .art-head__glass,
  .art-head__glass span {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* блюр задаётся переменной --glass-blur у слоя; -webkit- версия — в атрибуте style в разметке */
  .art-head__glass,
  .art-head__glass span {
    backdrop-filter: var(--glass-blur, none);
  }

  /*
   * 1. «Как в макете» — прогрессивное размытие: четыре слоя с разной силой блюра, каждый виден в своей
   *    полосе, сверху размыто сильнее всего, к низу сходит на нет; поверх — белая дымка 63 % → 0.
   *    Нижней границы нет совсем.
   */
  .art-head[data-glass='progressive'] .art-head__glass {
    background: linear-gradient(to bottom, rgb(250 250 250 / 0.63), rgb(250 250 250 / 0));
  }

  .art-head[data-glass='progressive'] .art-head__glass span:nth-child(1) {
    --glass-blur: blur(2px);
    mask-image: linear-gradient(to bottom, #000 0%, #000 60%, transparent 100%);
  }

  .art-head[data-glass='progressive'] .art-head__glass span:nth-child(2) {
    --glass-blur: blur(4px);
    mask-image: linear-gradient(to bottom, #000 0%, #000 40%, transparent 80%);
  }

  .art-head[data-glass='progressive'] .art-head__glass span:nth-child(3) {
    --glass-blur: blur(8px);
    mask-image: linear-gradient(to bottom, #000 0%, #000 20%, transparent 60%);
  }

  .art-head[data-glass='progressive'] .art-head__glass span:nth-child(4) {
    --glass-blur: blur(16px);
    mask-image: linear-gradient(to bottom, #000 0%, transparent 40%);
  }

  /*
   * 2. «Матовое стекло» — ровный сильный блюр с насыщенностью (как панели в iOS), белая подложка 72 %,
   *    у нижнего края стекло мягко растворяется на последних 16 px.
   */
  .art-head[data-glass='frosted'] .art-head__glass {
    background: rgb(250 250 250 / 0.72);
    --glass-blur: blur(24px) saturate(1.8);
    mask-image: linear-gradient(to bottom, #000 calc(100% - 16px), transparent);
  }

  /*
   * 3. «Мягкое стекло» — ровный средний блюр и белая дымка 85 % → 0, всё вместе плавно гаснет к низу:
   *    под текстом почти сплошной фон, ниже — лёгкое размытие.
   */
  .art-head[data-glass='soft'] .art-head__glass {
    background: linear-gradient(to bottom, rgb(250 250 250 / 0.85) 40%, rgb(250 250 250 / 0));
    --glass-blur: blur(12px);
    mask-image: linear-gradient(to bottom, #000 50%, transparent);
  }

  /* 4. «Без блюра» — только белый градиент 92 % → 0: самый дешёвый для телефона, текст читается всегда. */
  .art-head[data-glass='plain'] .art-head__glass {
    background: linear-gradient(to bottom, rgb(250 250 250 / 0.92) 45%, rgb(250 250 250 / 0));
  }

  @media (max-width: 767px) {
    .art-head {
      padding-block: var(--space-20);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .art-head {
      transition: opacity 200ms ease-out;
    }

    .art-head.is-hidden {
      translate: none;
    }
  }
</style>
