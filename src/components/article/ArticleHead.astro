---
/**
 * Всплывающая шапка статьи (Figma 746:12778): полоса во всю ширину, в колонке 688 — хлебные крошки,
 * чтобы с любого места статьи вернуться на главную. Desktop 84 (поля 32), mobile — поля страницы.
 * Поведение (src/scripts/article-head.ts): на первом экране статьи не показывается совсем; ниже —
 * появляется при скролле вверх и уезжает при скролле вниз. Фон — прогрессивное стекло: размытие сильнее
 * всего сверху и сходит на нет к низу, поверх — белая дымка, как в макете.
 */
import Crumbs from './Crumbs.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const WEBKIT = '-webkit-backdrop-filter: var(--glass-blur, none)';
---

<div class="art-head is-hidden" data-art-head inert>
  {/* -webkit-backdrop-filter (Safari до 18) — в атрибуте: из CSS сборка его выбрасывает */}
  <div class="art-head__glass" aria-hidden="true" style={WEBKIT}>
    <span style={WEBKIT}></span><span style={WEBKIT}></span><span style={WEBKIT}></span><span style={WEBKIT}></span>
  </div>
  <div class="art-head__inner">
    <Crumbs title={title} label="Хлебные крошки, шапка" />
  </div>
</div>

<script>
  import { mountArticleHead } from '../../scripts/article-head';
  const root = document.querySelector<HTMLElement>('[data-art-head]');
  if (root) mountArticleHead(root);
</script>

<style>
  .art-head {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    padding: var(--space-32) var(--layout-page-padding);
    transition:
      translate 400ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .art-head.is-hidden {
    translate: 0 -100%;
    opacity: 0;
  }

  .art-head__inner {
    position: relative;
    max-width: var(--layout-column-width);
    margin-inline: auto;
  }

  .art-head__glass,
  .art-head__glass span {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* блюр задаётся переменной --glass-blur у слоя; -webkit- версия — в атрибуте style в разметке */
  .art-head__glass,
  .art-head__glass span {
    backdrop-filter: var(--glass-blur, none);
  }

  /*
   * Прогрессивное размытие: четыре слоя с разной силой блюра, каждый виден в своей полосе — сверху
   * размыто сильнее всего, к низу сходит на нет; поверх — белая дымка 63 % → 0. Нижней границы нет.
   */
  .art-head__glass {
    background: linear-gradient(to bottom, rgb(250 250 250 / 0.63), rgb(250 250 250 / 0));
  }

  .art-head__glass span:nth-child(1) {
    --glass-blur: blur(2px);
    mask-image: linear-gradient(to bottom, #000 0%, #000 60%, transparent 100%);
  }

  .art-head__glass span:nth-child(2) {
    --glass-blur: blur(4px);
    mask-image: linear-gradient(to bottom, #000 0%, #000 40%, transparent 80%);
  }

  .art-head__glass span:nth-child(3) {
    --glass-blur: blur(8px);
    mask-image: linear-gradient(to bottom, #000 0%, #000 20%, transparent 60%);
  }

  .art-head__glass span:nth-child(4) {
    --glass-blur: blur(16px);
    mask-image: linear-gradient(to bottom, #000 0%, transparent 40%);
  }

  @media (max-width: 767px) {
    .art-head {
      padding-block: var(--space-20);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .art-head {
      transition: opacity 200ms ease-out;
    }

    .art-head.is-hidden {
      translate: none;
    }
  }
</style>
