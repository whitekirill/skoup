---
/**
 * Навигация по статье: Article nav button (624:6528), Article nav (624:6545), Article nav item (624:6543).
 * Закрыта (598:9833): плавающая кнопка внизу по центру — текущий раздел и иконка align-left.
 * Открыта (602:12258 / 637:8984): оверлей — градиент static/black снизу вверх (вместо размытия из макета),
 * над кнопкой панель с разделами (текущий — Active), кнопка — «Закрыть».
 * Поведение — src/scripts/article-nav.ts.
 */

interface Props {
  items: { id: string; label: string }[];
}
const { items } = Astro.props;
---

<div class="art-nav" data-art-nav>
  <div class="art-nav__overlay" data-art-nav-overlay aria-hidden="true">
    <div class="art-nav__tint"></div>
  </div>
  <div class="art-nav__dock">
    <nav class="art-nav__panel t-button-l" id="article-toc" aria-label="Содержание" data-art-nav-panel inert>
      <ol class="art-nav__list">
        {
          items.map((item, i) => (
            <li>
              <a class="art-nav__item" href={`#${item.id}`} data-art-nav-item={item.id}>
                <span class="art-nav__num">{i}</span>
                <span class="art-nav__label">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <button class="art-nav__button t-button-l" type="button" aria-expanded="false" aria-controls="article-toc" data-art-nav-button>
      <span class="art-nav__current" data-art-nav-current>{items[0]?.label}</span>
      <span class="art-nav__close">Закрыть</span>
      <!-- align-left (строки) ↔ x: две длинные строки поворачиваются в крестик, короткие гаснут -->
      <svg class="art-nav__morph" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <line class="art-nav__line art-nav__line--1" x1="-9" x2="9" />
        <line class="art-nav__line art-nav__line--2" x1="-6" x2="6" />
        <line class="art-nav__line art-nav__line--3" x1="-9" x2="9" />
        <line class="art-nav__line art-nav__line--4" x1="-6" x2="6" />
      </svg>
    </button>
  </div>
</div>

<script>
  import { mountArticleNav } from '../../scripts/article-nav';
  const root = document.querySelector<HTMLElement>('[data-art-nav]');
  if (root) mountArticleNav(root);
</script>

<style>
  .art-nav {
    --nav-ease: cubic-bezier(0.2, 0, 0, 1);
    --nav-time: 400ms;
  }

  /* Оверлей: градиент static/black — тёмный у кнопки внизу, к верху прозрачный */
  .art-nav__overlay {
    position: fixed;
    inset: 0;
    z-index: 40;
    visibility: hidden;
    transition: visibility var(--nav-time);
  }

  .art-nav__tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, color-mix(in srgb, var(--color-static-black) 40%, transparent), transparent);
    opacity: 0;
    transition: opacity var(--nav-time) var(--nav-ease);
  }

  .art-nav.is-open .art-nav__overlay {
    visibility: visible;
    transition: visibility 0s;
  }

  .art-nav.is-open .art-nav__tint {
    opacity: 1;
  }

  /* Кнопка и панель: по центру снизу, 24 px от низа окна */
  .art-nav__dock {
    position: fixed;
    bottom: var(--space-24);
    left: 50%;
    z-index: 41;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xs);
    width: calc(var(--space-100) * 4 + var(--space-28));
    max-width: calc(100% - 2 * var(--layout-article-padding));
    translate: -50% 0;
    pointer-events: none;
    transition:
      transform var(--nav-time) var(--nav-ease),
      opacity var(--nav-time) var(--nav-ease);
  }

  .art-nav__dock > * {
    pointer-events: auto;
  }

  /* Спрятана (первый экран или скролл вниз): уезжает за нижний край */
  .art-nav.is-hidden:not(.is-open) .art-nav__dock {
    transform: translateY(calc(100% + var(--space-24)));
  }

  .art-nav.is-hidden:not(.is-open) .art-nav__dock > * {
    pointer-events: none;
  }

  .art-nav__button {
    display: flex;
    align-items: center;
    gap: var(--gap-4xs);
    width: calc(var(--space-100) * 3 + var(--space-56));
    max-width: 100%;
    height: var(--size-button-height);
    padding: 0 var(--space-16);
    border-radius: var(--radius-full);
    background: var(--color-surface-secondary);
    color: var(--color-text-primary);
    text-align: left;
    box-shadow: var(--effect-shadow-floating);
    -webkit-tap-highlight-color: transparent;
    transition:
      width var(--nav-time) var(--nav-ease),
      background-color var(--nav-time) var(--nav-ease),
      color var(--nav-time) var(--nav-ease),
      scale 150ms ease-out;
  }

  /* Hover и фокус — бледнеют подпись и иконка, плашка не меняется, как у всех кнопок */
  .art-nav__button:focus-visible {
    outline: none;
  }

  /* бледнеет видимая подпись (раздел или «Закрыть») и иконка */
  .art-nav:not(.is-open) .art-nav__button:is(:focus-visible, :active) .art-nav__current,
  .art-nav.is-open .art-nav__button:is(:focus-visible, :active) .art-nav__close,
  .art-nav__button:is(:focus-visible, :active) .art-nav__morph {
    opacity: 0.6;
  }

  @media (hover: hover) and (pointer: fine) {
    .art-nav:not(.is-open) .art-nav__button:hover .art-nav__current,
    .art-nav.is-open .art-nav__button:hover .art-nav__close,
    .art-nav__button:hover .art-nav__morph {
      opacity: 0.6;
    }

    .art-nav__item:hover {
      color: var(--color-text-primary);
    }

    .art-nav__item:hover .art-nav__num {
      color: var(--color-text-secondary);
    }
  }

  /* Подписи «раздел» и «Закрыть» лежат друг на друге и сменяются прозрачностью */
  .art-nav__current,
  .art-nav__close {
    grid-area: 1 / 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: opacity 200ms ease-out;
  }

  .art-nav__button {
    display: grid;
    grid-template-columns: 1fr auto;
  }

  .art-nav__morph {
    grid-area: 1 / 2;
    flex-shrink: 0;
    transition: opacity 150ms ease-out;
  }

  .art-nav__close {
    opacity: 0;
  }

  .art-nav.is-open .art-nav__button {
    width: 100%;
    background: var(--color-surface-primary-inversion);
    color: var(--color-text-primary-inversion);
  }

  .art-nav.is-open .art-nav__current {
    opacity: 0;
  }

  .art-nav.is-open .art-nav__close {
    opacity: 1;
  }

  /* Строки ↔ крестик: линии нарисованы вокруг (0,0) и расставлены transform-ом */
  .art-nav__line {
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    transition:
      transform var(--nav-time) var(--nav-ease),
      opacity var(--nav-time) var(--nav-ease);
  }

  .art-nav__line--1 { transform: translate(12px, 4.5px); }
  .art-nav__line--2 { transform: translate(9px, 9.5px); }
  .art-nav__line--3 { transform: translate(12px, 14.5px); }
  .art-nav__line--4 { transform: translate(9px, 19.5px); }

  .art-nav.is-open .art-nav__line--1 { transform: translate(12px, 12px) rotate(45deg) scaleX(0.82); }
  .art-nav.is-open .art-nav__line--3 { transform: translate(12px, 12px) rotate(-45deg) scaleX(0.82); }

  .art-nav.is-open .art-nav__line--2,
  .art-nav.is-open .art-nav__line--4 {
    transform: translate(12px, 12px) scaleX(0);
    opacity: 0;
  }

  /* Панель оглавления: растёт из кнопки — снизу, с прозрачностью и небольшим сдвигом */
  .art-nav__panel {
    width: 100%;
    padding: var(--space-24);
    border-radius: var(--radius-32);
    background: var(--color-surface-tertiary);
    transform-origin: 50% 100%;
    opacity: 0;
    transform: translateY(var(--space-16)) scale(0.96);
    visibility: hidden;
    transition:
      opacity var(--nav-time) var(--nav-ease),
      transform var(--nav-time) var(--nav-ease),
      visibility var(--nav-time);
  }

  .art-nav.is-open .art-nav__panel {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition:
      opacity var(--nav-time) var(--nav-ease),
      transform var(--nav-time) var(--nav-ease),
      visibility 0s;
  }

  .art-nav__list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
  }

  .art-nav__item {
    display: inline-flex;
    gap: var(--space-10);
    max-width: 100%;
    border-bottom: 1px solid transparent;
    color: var(--color-text-secondary);
    white-space: nowrap;
    transition:
      color 150ms ease-out,
      border-color 150ms ease-out;
  }

  .art-nav__label {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .art-nav__num {
    color: var(--color-text-secondary-inversion);
    transition: color 150ms ease-out;
  }

  .art-nav__item:focus-visible {
    outline: none;
    color: var(--color-text-primary);
  }

  .art-nav__item[aria-current='true'] {
    border-bottom-color: var(--color-element-border-inversion);
    color: var(--color-text-primary);
  }

  .art-nav__item[aria-current='true'] .art-nav__num {
    color: inherit;
  }

  @media (prefers-reduced-motion: no-preference) {
    .art-nav__button:active {
      scale: 0.96;
    }
  }

  /* reduced motion — без сдвигов и превращений: только прозрачность */
  @media (prefers-reduced-motion: reduce) {
    .art-nav__dock,
    .art-nav__panel,
    .art-nav.is-open .art-nav__panel {
      transform: none;
    }

    .art-nav.is-hidden:not(.is-open) .art-nav__dock {
      transform: none;
      opacity: 0;
    }

    .art-nav__line {
      transition: opacity var(--nav-time) var(--nav-ease);
    }

    .art-nav__button {
      transition: background-color var(--nav-time), color var(--nav-time), opacity 150ms;
    }
  }

  @media (max-width: 767px) {
    .art-nav__dock {
      gap: var(--gap-2xs);
      width: calc(100% - 2 * var(--layout-article-padding));
    }

    .art-nav__button {
      width: 100%;
    }
  }
</style>
