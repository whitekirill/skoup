---
/**
 * Навигация по статье: Article nav button (624:6528), Article nav (624:6545), Article nav item (624:6543).
 * Закрыта (598:9833): плавающая кнопка внизу по центру — текущий раздел и иконка align-left.
 * Открыта (602:12258 / 637:8984): оверлей static/black 16% + прогрессивное размытие Blur/Overlay,
 * над кнопкой панель с разделами (текущий — Active), кнопка — «Закрыть».
 * Поведение — src/scripts/article-nav.ts.
 */
import Icon from '../Icon.astro';

interface Props {
  items: { id: string; label: string }[];
}
const { items } = Astro.props;
---

<div class="art-nav" data-art-nav>
  <div class="art-nav__overlay" data-art-nav-overlay aria-hidden="true">
    <div class="art-nav__blur"></div>
  </div>
  <div class="art-nav__dock">
    <nav class="art-nav__panel t-button-l" id="article-toc" aria-label="Содержание" data-art-nav-panel hidden>
      <ol class="art-nav__list">
        {
          items.map((item, i) => (
            <li>
              <a class="art-nav__item" href={`#${item.id}`} data-art-nav-item={item.id}>
                <span class="art-nav__num">{i}</span>
                <span class="art-nav__label">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <button class="art-nav__button t-button-l" type="button" aria-expanded="false" aria-controls="article-toc" data-art-nav-button>
      <span class="art-nav__current" data-art-nav-current>{items[0]?.label}</span>
      <span class="art-nav__close">Закрыть</span>
      <Icon name="align-left-line" class="art-nav__icon-open" />
      <Icon name="x-line" class="art-nav__icon-close" />
    </button>
  </div>
</div>

<script>
  import { mountArticleNav } from '../../scripts/article-nav';
  const root = document.querySelector<HTMLElement>('[data-art-nav]');
  if (root) mountArticleNav(root);
</script>

<style>
  .art-nav {
    --nav-ease: cubic-bezier(0.2, 0, 0, 1);
  }

  /* Оверлей: затемнение 16% на весь экран + размытие, которое нарастает сверху вниз */
  .art-nav__overlay {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--color-static-black) 16%, transparent);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 250ms ease-out,
      visibility 250ms;
  }

  .art-nav__blur {
    position: absolute;
    inset: 0;
    backdrop-filter: var(--effect-blur-overlay);
    -webkit-backdrop-filter: var(--effect-blur-overlay);
    mask-image: var(--effect-blur-overlay-mask);
  }

  .art-nav.is-open .art-nav__overlay {
    opacity: 1;
    visibility: visible;
    transition: opacity 250ms ease-out;
  }

  /* Кнопка и панель: по центру снизу, 24 px от низа окна */
  .art-nav__dock {
    position: fixed;
    bottom: var(--space-24);
    left: 50%;
    z-index: 41;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xs);
    width: calc(var(--space-100) * 4 + var(--space-28));
    max-width: calc(100% - 2 * var(--layout-article-padding));
    translate: -50% 0;
    pointer-events: none;
    transition: transform 250ms ease-out;
  }

  .art-nav__dock > * {
    pointer-events: auto;
  }

  /* Прячется при скролле вниз: уезжает за нижний край */
  .art-nav.is-hidden:not(.is-open) .art-nav__dock {
    transform: translateY(calc(100% + var(--space-24)));
  }

  .art-nav__button {
    display: flex;
    align-items: center;
    gap: var(--gap-4xs);
    width: calc(var(--space-100) * 3 + var(--space-56));
    max-width: 100%;
    height: var(--size-button-height);
    padding: 0 var(--space-16);
    border-radius: var(--radius-full);
    background: var(--color-surface-secondary);
    color: var(--color-text-primary);
    text-align: left;
    box-shadow: var(--effect-shadow-floating);
    -webkit-tap-highlight-color: transparent;
    transition-property: background-color, color, scale;
    transition-duration: 150ms;
    transition-timing-function: ease-out;
  }

  .art-nav__button:focus-visible {
    outline: none;
    background: var(--color-element-border-2);
  }

  @media (hover: hover) and (pointer: fine) {
    .art-nav__button:hover {
      background: var(--color-element-border-2);
    }

    .art-nav.is-open .art-nav__button:hover {
      background: var(--color-surface-secondary-inversion);
    }

    .art-nav__item:hover {
      color: var(--color-text-primary);
    }

    .art-nav__item:hover .art-nav__num {
      color: var(--color-text-secondary);
    }
  }

  .art-nav__current,
  .art-nav__close {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .art-nav__close,
  .art-nav__button :global(.art-nav__icon-close) {
    display: none;
  }

  .art-nav.is-open .art-nav__button {
    width: 100%;
    background: var(--color-surface-primary-inversion);
    color: var(--color-text-primary-inversion);
  }

  .art-nav.is-open .art-nav__button:focus-visible {
    background: var(--color-surface-secondary-inversion);
  }

  .art-nav.is-open .art-nav__current,
  .art-nav.is-open .art-nav__button :global(.art-nav__icon-open) {
    display: none;
  }

  .art-nav.is-open .art-nav__close,
  .art-nav.is-open .art-nav__button :global(.art-nav__icon-close) {
    display: block;
  }

  /* Панель оглавления */
  .art-nav__panel {
    width: 100%;
    padding: var(--space-24);
    border-radius: var(--radius-32);
    background: var(--color-surface-tertiary);
  }

  .art-nav__panel[hidden] {
    display: none;
  }

  .art-nav__list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
  }

  .art-nav__item {
    display: inline-flex;
    gap: var(--space-10);
    max-width: 100%;
    border-bottom: 1px solid transparent;
    color: var(--color-text-secondary);
    white-space: nowrap;
    transition: color 150ms ease-out;
  }

  .art-nav__label {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .art-nav__num {
    color: var(--color-text-secondary-inversion);
    transition: color 150ms ease-out;
  }

  .art-nav__item:focus-visible {
    outline: none;
    color: var(--color-text-primary);
  }

  .art-nav__item[aria-current='true'] {
    border-bottom-color: var(--color-element-border-inversion);
    color: var(--color-text-primary);
  }

  .art-nav__item[aria-current='true'] .art-nav__num {
    color: inherit;
  }

  @media (prefers-reduced-motion: no-preference) {
    .art-nav__button:active {
      scale: 0.96;
    }

    .art-nav__panel:not([hidden]) {
      animation: none;
      transition:
        opacity 250ms var(--nav-ease),
        translate 250ms var(--nav-ease);
    }

    @starting-style {
      .art-nav__panel:not([hidden]) {
        opacity: 0;
        translate: 0 var(--space-12);
      }
    }
  }

  /* reduced motion — кнопка не уезжает, а гаснет */
  @media (prefers-reduced-motion: reduce) {
    .art-nav__dock {
      transition: opacity 250ms ease-out;
    }

    .art-nav.is-hidden:not(.is-open) .art-nav__dock {
      transform: none;
      opacity: 0;
      pointer-events: none;
    }

    .art-nav.is-hidden:not(.is-open) .art-nav__dock > * {
      pointer-events: none;
    }
  }

  @media (max-width: 767px) {
    .art-nav__dock {
      gap: var(--gap-2xs);
      width: calc(100% - 2 * var(--layout-article-padding));
    }

    .art-nav__button {
      width: 100%;
    }
  }
</style>
