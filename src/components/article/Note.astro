---
/**
 * Плашка «Выводы» (Figma 817:11981): фон tint/green, заголовок Body/Medium Bold, ниже нумерованные пункты —
 * номер в кружке 24 px (обводка 2 px element/border-inversion, цифра Body/Small), 12 px до текста Body/Medium.
 * Ссылка на законы (821:12907) — отдельным абзацем после плашки, Body/Small text/secondary;
 * отступ до неё — gap секции. Пункты передаются в слот как <li>.
 */
interface Props {
  law: string;
  title?: string;
}
const { law, title = 'Выводы' } = Astro.props;
---

<aside class="note" aria-label={title}>
  <p class="t-body-m-bold">{title}</p>
  <ol class="note__list t-body-m"><slot /></ol>
</aside>
<p class="note-law t-body-s">{law}</p>

<style>
  .note {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    padding: var(--space-24);
    border-radius: var(--radius-24);
    background: var(--color-tint-green);
  }

  .note__list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    counter-reset: note;
  }

  /* номер — вне потока, чтобы ссылки и выделение внутри пункта не ломали строку */
  .note__list :global(li) {
    position: relative;
    padding-inline-start: calc(24px + 12px);
    counter-increment: note;
  }

  /* кружок 24 px по центру первой строки (строка Body/Medium — 32 px) */
  .note__list :global(li)::before {
    content: counter(note);
    position: absolute;
    top: calc((var(--typography-body-m-line-height) - 24px) / 2);
    inset-inline-start: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 24px;
    height: 24px;
    border: 2px solid var(--color-element-border-inversion);
    border-radius: var(--radius-full);
    font-size: var(--typography-body-s-size);
    line-height: var(--typography-body-s-line-height);
    letter-spacing: var(--typography-body-s-letter-spacing);
  }

  .note-law {
    color: var(--color-text-secondary);
  }
</style>
