---
/** StepCard (Figma 407:156): длительность + текст (первая часть белая, вторая — вторичная) */
interface Props {
  duration: string;
  lead: string;
  rest: string;
  /** Перенос строки после lead, как в макете */
  breakAfterLead?: boolean;
}

const { duration, lead, rest, breakAfterLead = false } = Astro.props;
---

<li class="step">
  <span class="step__duration t-button-s">{duration}</span>
  <p class="step__text t-h5">{lead}{breakAfterLead ? <br /> : ' '}<span class="step__rest">{rest}</span></p>
</li>

<style>
  .step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-12);
    padding: var(--size-step-padding);
    background: var(--surface-step-card);
  }

  .step__duration {
    padding: var(--space-4) var(--space-8);
    background: var(--color-element-border-inversion);
    color: var(--color-text-primary-inversion);
  }

  .step__text {
    color: var(--color-text-primary-inversion);
  }

  .step__rest {
    color: var(--color-text-secondary-inversion);
  }
</style>
