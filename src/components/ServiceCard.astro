---
/** ServiceCard (Figma 411:11514): Illustration, Title, Description */
import { typograph } from '../utils/typograph';

interface Props {
  title: string;
  description: string;
  illustration: string;
}

const { title, description, illustration } = Astro.props;
---

<article class="service">
  <img class="service__illustration" src={illustration} alt="" width="189" height="132" loading="lazy" decoding="async" />
  <div class="service__body">
    <h3 class="service__title t-h5" set:html={title} />
    <p class="service__description t-body-s">{typograph(description)}</p>
  </div>
</article>

<style>
  /* Высота по содержимому; ширина — колонка сетки (258 на 1440, вся ширина на мобилке) */
  .service {
    display: flex;
    flex-direction: column;
    gap: var(--size-service-gap);
    padding: var(--size-service-padding);
    background: var(--color-static-white);
  }

  /* 189×132; в узкой колонке уменьшается пропорционально */
  .service__illustration {
    width: var(--size-service-illustration-width);
    max-width: 100%;
    height: auto;
    aspect-ratio: 189 / 132;
  }

  .service__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .service__description {
    color: var(--color-text-secondary);
  }
</style>
