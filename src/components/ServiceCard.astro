---
/**
 * Service card (Figma 592:12984): Icon + текст Body/Large — заголовок text/primary, описание text/secondary.
 * Статичная. Цвет иконки — токен icon/*.
 */
import Icon, { type IconName } from './Icon.astro';
import { typograph } from '../utils/typograph';

export type IconColor = 'green' | 'purple' | 'yellow' | 'blue' | 'pink';

interface Props {
  icon: IconName;
  color: IconColor;
  title: string;
  /** HTML: переносы <br> из макета — только на desktop */
  description: string;
}

const { icon, color, title, description } = Astro.props;
---

<article class="service">
  <Icon name={icon} size={32} class={`service__icon icon-${color}`} />
  <p class="t-body-l">
    <span>{typograph(title)}</span>{' '}<span class="service__description" set:html={typograph(description).replace(/\s*<br>/g, ' <br>')} />
  </p>
</article>

<style>
  .service {
    display: flex;
    flex-direction: column;
    gap: var(--gap-s);
    padding: var(--space-24);
    border-radius: var(--radius-24);
    background: var(--color-static-white);
  }

  .service__description {
    color: var(--color-text-secondary);
  }

  @media (max-width: 767px) {
    .service__description :global(br) {
      display: none;
    }
  }
</style>
