---
/**
 * Fact card (Figma 592:13000): Icon, Value (Header/H3), Label (Body/Small text/secondary). Статичная.
 */
import Icon, { type IconName } from './Icon.astro';
import type { IconColor } from './ServiceCard.astro';

interface Props {
  icon: IconName;
  color: IconColor;
  value: string;
  /** HTML: переносы <br> из макета — только на desktop */
  label: string;
}

const { icon, color, value, label } = Astro.props;
---

<div class="fact">
  <Icon name={icon} size={32} class={`icon-${color}`} />
  <div class="fact__text">
    <p class="t-h3">{value}</p>
    <p class="fact__label t-body-s" set:html={label.replace(/\s*<br>/g, ' <br>')} />
  </div>
</div>

<style>
  .fact {
    display: flex;
    flex-direction: column;
    gap: var(--size-fact-gap);
    padding: var(--space-24);
    border-radius: var(--radius-24);
    background: var(--color-surface-tertiary);
  }

  .fact__label {
    color: var(--color-text-secondary);
  }

  @media (max-width: 767px) {
    .fact__label :global(br) {
      display: none;
    }
  }
</style>
