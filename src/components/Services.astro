---
/**
 * «Что мы делаем» (Figma: desktop 469:5247, mobile 482:3284).
 * Desktop — пять карточек в ряд со ступенчатым сдвигом по вертикали, Mobile — столбик.
 */
import ServiceCard from './ServiceCard.astro';
import strategy from '../assets/services/strategy.svg?url';
import interfaces from '../assets/services/interfaces.svg?url';
import regulatory from '../assets/services/regulatory.svg?url';
import analytics from '../assets/services/analytics.svg?url';
import audit from '../assets/services/audit.svg?url';

// offset — сдвиг карточки вниз на десктопе, px от верхней (как в макете 1440)
const services = [
  {
    title: 'Стратегия и&nbsp;исследования',
    description: 'Изучаем бизнес и клиентов, составляем план развития продукта с учётом требований закона',
    illustration: strategy,
    offset: 46,
  },
  {
    title: 'Интерфейсы<br />и дизайн-системы',
    description: 'Экраны, сценарии и дизайн‑системы, которые разработка берёт без переделок',
    illustration: interfaces,
    offset: 162,
  },
  {
    title: 'Регуляторика',
    description: 'Встраиваем требования регуляторов в интерфейс и готовим документацию к проверкам',
    illustration: regulatory,
    offset: 0,
  },
  {
    title: 'Аналитика и рост',
    description: 'Изучаем данные и проводим A/B-тесты, чтобы росла конверсия',
    illustration: analytics,
    offset: 236,
  },
  {
    title: 'Аудит и исправления',
    description: 'Проверяем удобство и соответствие закону, помогаем всё исправить',
    illustration: audit,
    offset: 63,
  },
];
---

<section class="services" id="services" aria-labelledby="services-title">
  <div class="services__inner container">
    <h2 class="services__title t-h2" id="services-title">Что мы делаем</h2>
    <ul class="services__list">
      {
        services.map(({ offset, ...service }) => (
          <li style={`--offset: ${offset}px`}>
            <ServiceCard {...service} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services {
    padding-block: var(--layout-section-padding);
    background: var(--color-surface-secondary);
  }

  .services__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-44);
  }

  .services__title {
    max-width: 896px;
  }

  /* 5 колонок по 258 на 1440 (зазор 15.5 — как в макете), карточки сдвинуты вниз на --offset */
  .services__list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    align-items: start;
    column-gap: 15.5px;
  }

  .services__list > li {
    margin-top: var(--offset);
  }

  /* Между мобилкой и узким десктопом пять колонок слишком тесные — три в ряд, без ступенек */
  @media (max-width: 1099px) {
    .services__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-8);
    }

    .services__list > li {
      margin-top: 0;
    }
  }

  @media (max-width: 767px) {
    .services__inner {
      gap: var(--space-24);
    }

    .services__list {
      grid-template-columns: 1fr;
    }
  }
</style>
