---
/** «Блог» (Figma: desktop 376:8780, mobile 391:3438) */
import BlogPost from './BlogPost.astro';
import { POSTS } from '../data/site';
---

<section class="blog container" id="blog" aria-labelledby="blog-title">
  <h2 class="t-h2" id="blog-title">Блог</h2>
  <ul class="blog__posts">
    {
      POSTS.map((post) => (
        <li class="blog__item">
          <BlogPost {...post} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .blog {
    display: flex;
    flex-direction: column;
    gap: var(--gap-l);
    padding-block: var(--layout-section-padding);
    background: var(--color-surface-secondary);
  }

  .blog__posts {
    display: flex;
    flex-direction: column;
    gap: var(--gap-s);
  }

  /* Border=Yes — разделитель у всех, кроме последнего; в Figma обводка внутри, высоту не добавляет */
  .blog__item:not(:last-child) {
    padding-bottom: var(--gap-s);
    box-shadow: inset 0 -1px 0 var(--color-element-border);
  }

  @media (max-width: 767px) {
    .blog {
      gap: var(--space-32);
    }

    .blog__posts {
      gap: var(--space-24);
    }
  }
</style>
