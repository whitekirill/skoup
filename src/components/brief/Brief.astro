---
/**
 * Бриф — полноэкранный оверлей поверх главной (Figma: desktop 581:20495, mobile 633:10386,
 * успех 628:7677 / 633:10497). Открывается по CTA с data-brief-open и по /#brief.
 * Desktop — две колонки (заголовок секции 440 слева, поля 782 справа), Mobile — одна. Футера нет.
 */
import Button from '../Button.astro';
import RoundButton from '../RoundButton.astro';
import Icon from '../Icon.astro';
import Field from './Field.astro';
import Chip from '../Chip.astro';
import FileUpload from './FileUpload.astro';
import { EMAIL, LEGAL } from '../../data/site';
import { BUDGETS, PRESENTATION_URL, SERVICES, TELEGRAM_URL } from '../../data/brief';
---

<div class="brief-shade" aria-hidden="true"></div>
<dialog class="brief" id="brief" aria-labelledby="brief-title" aria-modal="true" data-brief>
  <div class="brief__main">
    <div class="brief__bar">
      <RoundButton variant="filled" icon="x-line" label="Закрыть бриф" class="brief__close" data-brief-close />
    </div>

    <!-- Форма -->
    <div class="brief__view" data-brief-view="form">
      <!-- Заголовок как в макете: слова и ссылки — отдельные блоки с зазором gap-4xs, переносятся целиком -->
      <h2 class="brief__title t-h2 brief__reveal" id="brief-title" style="--i: 0" tabindex="-1">
        <span>Расскажите</span> <span>о</span> <span>проекте</span>
        <span class="brief__break" aria-hidden="true"></span>
        <span class="brief__muted">или напишите нам</span> <span class="brief__muted">в</span>
        <a class="brief__contact brief__contact--tg" href={TELEGRAM_URL} target="_blank" rel="noopener">
          <Icon name="paperplane" size={44} /><span>telegram</span>
        </a>
        <span class="brief__break brief__break--desktop" aria-hidden="true"></span>
        <span class="brief__muted">или</span> <span class="brief__muted">на</span>
        <a class="brief__contact brief__contact--mail" href={`mailto:${EMAIL}`}>
          <Icon name="envelope" size={44} /><span>{EMAIL}</span>
        </a>
      </h2>

      <form class="brief__form" novalidate data-brief-form>
        <section class="brief__section brief__reveal" style="--i: 1" aria-labelledby="brief-about">
          <h3 class="brief__heading t-h3" id="brief-about">О вас</h3>
          <div class="brief__content brief__fields">
            <Field name="name" label="Имя" autocomplete="name" required />
            <Field name="company" label="Компания" autocomplete="organization" required />
            <Field name="contact" label="Email или другой контакт" autocomplete="email" plain required />
            <Field name="phone" label="Телефон" type="tel" autocomplete="tel" inputmode="tel" required />
          </div>
        </section>

        <section class="brief__section brief__reveal" style="--i: 2" aria-labelledby="brief-project">
          <h3 class="brief__heading t-h3" id="brief-project">О проекте</h3>
          <div class="brief__content brief__fields">
            <fieldset class="brief__group" data-group="services" aria-describedby="brief-services-error">
              <legend class="brief__legend t-body-m">Какие услуги вас интересуют?</legend>
              <div class="brief__chips">
                {SERVICES.map((service) => <Chip type="checkbox" name="services" value={service} />)}
              </div>
              <p class="brief__group-error t-body-s" id="brief-services-error" hidden></p>
            </fieldset>
            <div class="brief__task">
              <Field name="task" label="Опишите задачу" multiline />
              <FileUpload />
            </div>
          </div>
        </section>

        <section class="brief__section brief__reveal" style="--i: 3" aria-labelledby="brief-budget">
          <h3 class="brief__heading t-h3" id="brief-budget">Бюджет</h3>
          <div class="brief__content">
            <fieldset class="brief__group" data-group="budget" aria-describedby="brief-budget-error">
              <legend class="visually-hidden">Бюджет</legend>
              <div class="brief__chips">
                {BUDGETS.map((budget) => <Chip type="radio" name="budget" value={budget} />)}
              </div>
              <p class="brief__group-error t-body-s" id="brief-budget-error" hidden></p>
            </fieldset>
          </div>
        </section>

        <div class="brief__section brief__reveal" style="--i: 4">
          <div class="brief__content brief__submit">
            <div class="brief__send">
              <Button variant="primary" type="submit" class="brief__button" data-brief-submit>Отправить заявку</Button>
              <p class="brief__send-error t-body-s" role="alert" data-brief-send-error></p>
            </div>
            <p class="brief__consent t-body-m">
              Нажимая на кнопку, вы даёте согласие на <a href={LEGAL[0].href}>обработку персональных данных</a>{" "}<br class="brief__br-desktop" />
              и соглашаетесь с <a href={LEGAL[0].href}>политикой конфиденциальности</a>.
            </p>
          </div>
        </div>
      </form>
    </div>

    <!-- Экран успеха -->
    <div class="brief__view brief__success" data-brief-view="success" hidden>
      <div class="brief__success-message">
        <Icon name="check-circle" size={80} class="brief__check" />
        <div class="brief__success-text">
          <h2 class="t-h3" tabindex="-1" data-brief-success-title>Заявка отправлена,<br />скоро свяжемся с&nbsp;вами</h2>
          <p class="brief__success-note t-body-m">
            Изучим бриф, при необходимости уточним детали<br class="brief__br-desktop" /> и предложим время для звонка.
          </p>
        </div>
      </div>
      <div class="brief__success-actions">
        <Button variant="primary" href={PRESENTATION_URL} download iconRight="arrow-to-bracket-down-line">Презентация</Button>
        <Button variant="secondary" data-brief-close>На главную</Button>
      </div>
    </div>
  </div>
</dialog>

<script>
  import '../../scripts/brief/index';
</script>

<style is:global>
  /*
   * Пока бриф открыт, страница под ним чуть уменьшается.
   * overflow у страницы не трогаем: модальный dialog на весь экран и так забирает колесо, тач
   * и фокус (overscroll-behavior: contain), а смена overflow убирала полосу прокрутки —
   * страница прыгала вбок и перекладывалась целиком, отсюда рывки при открытии и закрытии.
   * Lenis на паузе, но без своего overflow: clip.
   */
  html.lenis.is-brief-open.lenis-stopped {
    overflow: visible;
  }


  @media (prefers-reduced-motion: no-preference) {
    .page > main {
      transition: scale 700ms cubic-bezier(0.76, 0, 0.24, 1);
    }

    html.is-brief-open .page > main {
      scale: 0.96;
    }
  }
</style>

<style>
  /* Панель на весь экран: выезжает снизу; содержимое прокручивается внутри */
  .brief {
    --brief-ease: cubic-bezier(0.76, 0, 0.24, 1);
    position: fixed;
    inset: 0;
    z-index: 50;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-surface-primary);
    color: var(--color-text-primary);
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /*
   * Закрытый бриф не убираем через display: none, а держим разложенным и невидимым
   * (visibility: hidden, сдвинут вниз). Иначе при открытии браузер с нуля раскладывает
   * всю форму и футер прямо в первом кадре анимации — это и давало рывок.
   */
  .brief,
  .brief:not([open]) {
    display: flex;
    flex-direction: column;
    visibility: hidden;
  }

  .brief[open] {
    visibility: visible;
  }

  /* панель фиксированной высоты — содержимое не сжимаем, оно прокручивается */
  .brief > :global(*) {
    flex-shrink: 0;
  }

  /* затемнение страницы под брифом (вместо ::backdrop — бриф открывается не модально, см. скрипт) */
  .brief-shade {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--color-surface-primary-inversion) 40%, transparent);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  :global(html.is-brief-open) .brief-shade {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .brief {
      translate: 0 100%;
      will-change: translate;
      transition:
        translate 700ms var(--brief-ease),
        visibility 700ms;
    }

    /* при открытии видимость включается сразу (иначе фокус не встанет на ×), при закрытии — в конце */
    .brief[open] {
      translate: 0 0;
      transition:
        translate 700ms var(--brief-ease),
        visibility 0s;
    }

    /* затемнение — мягче панели: без резкого перепада в середине, чуть дольше */
    .brief-shade {
      transition:
        opacity 900ms cubic-bezier(0.25, 0.1, 0.25, 1),
        visibility 900ms;
    }

    /* Контент — лесенкой: заголовок → секции → кнопка, шаг 60 мс, пока панель доезжает */
    .brief__reveal {
      opacity: 0;
      translate: 0 var(--space-24);
      transition:
        opacity 300ms ease-out,
        translate 300ms ease-out;
    }

    .brief[open] .brief__reveal {
      opacity: 1;
      translate: 0 0;
      transition:
        opacity 500ms cubic-bezier(0.2, 0, 0, 1),
        translate 500ms cubic-bezier(0.2, 0, 0, 1);
      transition-delay: calc(350ms + var(--i, 0) * 60ms);
    }
  }

  /* reduced motion — простой fade 200 мс */
  @media (prefers-reduced-motion: reduce) {
    .brief {
      opacity: 0;
      transition:
        opacity 200ms ease-out,
        visibility 200ms;
    }

    .brief-shade {
      transition:
        opacity 200ms ease-out,
        visibility 200ms;
    }

    /* visibility не в списке: глобальное правило reduced motion растянуло бы и её,
       и в первом кадре бриф был бы ещё невидим — фокус не встал бы на × */
    .brief[open] {
      opacity: 1;
      transition: opacity 200ms ease-out;
    }
  }

  .brief__main {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--layout-section-padding);
    padding: var(--space-32) var(--container-pad) var(--layout-section-padding);
  }

  /* × — справа вверху, в строке заголовка (desktop) */
  .brief__bar {
    position: absolute;
    top: var(--space-32);
    right: var(--container-pad);
    z-index: 1;
  }

  .brief__view {
    display: flex;
    flex-direction: column;
    gap: var(--layout-section-padding);
  }

  .brief__view[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .brief__view {
      transition: opacity 300ms ease-out;
    }

    .brief__view.is-leaving {
      opacity: 0;
    }

    @starting-style {
      .brief__view {
        opacity: 0;
      }
    }
  }

  /* Заголовок: слова — флекс-блоки с зазором gap-4xs (desktop 0 / 8, mobile 4 / 6), как в макете */
  .brief__title {
    --brief-icon: var(--space-44);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--gap-4xs);
    max-width: calc(782 / 1352 * 100%);
    outline: none;
  }

  .brief__title > * {
    white-space: nowrap;
  }

  /* перенос строки внутри флекса */
  .brief__break {
    flex-basis: 100%;
    height: 0;
  }

  .brief__muted {
    color: var(--color-text-secondary);
  }

  .brief__contact {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-3xs);
    color: var(--color-text-secondary);
    transition: color 200ms ease-out;
  }

  /* иконка 44 на desktop, 32 на mobile */
  .brief__contact :global(svg) {
    width: var(--brief-icon);
    height: var(--brief-icon);
  }

  .brief__contact:focus-visible {
    outline: none;
    color: var(--color-text-primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .brief__contact--tg:hover {
      color: var(--color-text-accent-2);
    }

    .brief__contact--mail:hover {
      color: var(--color-text-accent-1);
    }
  }

  .brief__form {
    display: flex;
    flex-direction: column;
    gap: var(--layout-section-padding);
  }

  /* Секция: заголовок 440 слева, поля 782 справа */
  .brief__section {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--gap-xs);
  }

  .brief__heading {
    width: calc(440 / 1352 * 100%);
  }

  .brief__content {
    width: calc(782 / 1352 * 100%);
    margin-left: auto;
  }

  .brief__fields {
    display: flex;
    flex-direction: column;
    gap: var(--layout-page-padding);
  }

  .brief__group {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .brief__legend {
    margin-bottom: var(--gap-s);
    padding: 0;
    color: var(--color-text-secondary);
  }

  .brief__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-3xs);
  }

  .brief__group-error {
    margin-top: var(--gap-4xs);
    color: var(--color-text-error);
  }

  .brief__task {
    display: flex;
    flex-direction: column;
    gap: var(--gap-s);
  }

  .brief__submit {
    display: flex;
    flex-direction: column;
    gap: var(--gap-s);
  }

  .brief__send {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-4xs);
  }

  .brief__send-error {
    color: var(--color-text-error);
  }

  .brief__send-error:empty {
    display: none;
  }

  .brief__consent {
    color: var(--color-text-secondary);
  }

  .brief__consent a {
    color: var(--color-text-accent-2);
    transition: color 150ms ease-out;
  }

  .brief__consent a:focus-visible {
    outline: none;
    color: var(--color-text-accent-2-hover);
  }

  @media (hover: hover) and (pointer: fine) {
    .brief__consent a:hover {
      color: var(--color-text-accent-2-hover);
    }
  }

  /* Экран успеха: по центру, колонка 782 */
  .brief__success {
    align-items: center;
    align-self: center;
    gap: var(--space-44);
    width: 100%;
    max-width: calc(782 / 1352 * 100%);
    padding-top: calc(var(--space-56) + var(--layout-section-padding));
    text-align: center;
  }

  .brief__success-message {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-s);
  }

  .brief__success-message :global(.brief__check) {
    color: var(--color-element-success);
  }

  .brief__success-text {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
  }

  .brief__success-text h2 {
    outline: none;
  }

  .brief__success-note {
    color: var(--color-text-secondary);
  }

  .brief__success-actions {
    display: flex;
    justify-content: center;
    gap: var(--gap-3xs);
    width: 100%;
  }

  @media (max-width: 767px) {
    .brief__br-desktop {
      display: none;
    }

    /* × — отдельной строкой сверху и закреплён при прокрутке */
    .brief__bar {
      position: sticky;
      top: var(--space-32);
      display: flex;
      justify-content: flex-end;
    }

    /* × и заголовок — gap-xs; до экрана успеха — section-padding, как в макете */
    .brief__main {
      gap: var(--gap-xs);
    }

    .brief__success {
      padding-top: calc(var(--layout-section-padding) - var(--gap-xs));
    }

    .brief__title,
    .brief__success {
      max-width: none;
    }

    .brief__section {
      flex-direction: column;
      gap: var(--gap-xs);
    }

    .brief__title {
      --brief-icon: var(--space-32);
      gap: var(--space-4) var(--gap-4xs);
    }

    .brief__break--desktop {
      display: none;
    }

    .brief__heading,
    .brief__content {
      width: 100%;
    }

    .brief__send :global(.btn),
    .brief__success-actions :global(.btn) {
      width: 100%;
    }

    .brief__success-actions {
      flex-direction: column;
    }
  }
</style>
