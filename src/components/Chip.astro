---
/**
 * Chip (Figma 632:7889). State: Default / Hover / Active; Label.
 * Это чекбокс (множественный выбор) или радио (один вариант): внутри настоящий input, клик переключает Default ↔ Active.
 * Default — surface/secondary; Hover и фокус с клавиатуры — подпись бледнеет; Active — surface/primary-inversion,
 * текст инверсный. Без обводок.
 */
interface Props {
  type: 'checkbox' | 'radio';
  name: string;
  value: string;
}

const { type, name, value } = Astro.props;
---

<label class="chip">
  <input class="chip__input" type={type} name={name} value={value} />
  <span class="chip__label t-button-l">{value}</span>
</label>

<style>
  .chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--gap-3xs) var(--gap-2xs);
    border-radius: var(--radius-full);
    background: var(--color-surface-secondary);
    color: var(--color-text-primary);
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition-property: background-color, color, scale;
    transition-duration: 150ms;
    transition-timing-function: ease-out;
  }

  /* сам input прячем визуально, но оставляем в фокусе и доступности */
  .chip__input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .chip__input:focus-visible {
    outline: none;
  }

  .chip__label {
    white-space: nowrap;
  }

  /* Hover и фокус с клавиатуры — бледнеет только подпись, плашка не меняется */
  .chip__label {
    transition: opacity 150ms ease-out;
  }

  .chip:has(.chip__input:focus-visible) .chip__label {
    opacity: 0.6;
  }

  @media (hover: hover) and (pointer: fine) {
    .chip:hover .chip__label {
      opacity: 0.6;
    }
  }

  .chip:has(.chip__input:checked) {
    background: var(--color-surface-primary-inversion);
    color: var(--color-text-primary-inversion);
  }

  @media (prefers-reduced-motion: no-preference) {
    .chip:active {
      scale: 0.96;
    }
  }
</style>
