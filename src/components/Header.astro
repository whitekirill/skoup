---
/**
 * Header (Figma 411:13712).
 * Desktop — логотип + навигация (Navbutton). Mobile — логотип + бургер, открывает MobileMenu.
 */
import Button from './Button.astro';
import Logo from './Logo.astro';
import MobileMenu from './MobileMenu.astro';
import MenuIcon from '../assets/icons/menu.svg';
import { NAV } from '../data/site';
---

<header class="header" data-header>
  <Logo />
  <nav class="header__nav" aria-label="Основная навигация">
    <ul class="header__list">
      {
        NAV.map((item) => (
          <li>
            <Button variant="nav" href={item.href}>
              {item.label}
            </Button>
          </li>
        ))
      }
    </ul>
  </nav>
  <button
    class="header__burger"
    type="button"
    aria-label="Открыть меню"
    aria-haspopup="dialog"
    aria-controls="mobile-menu"
    aria-expanded="false"
    data-menu-open
  >
    <MenuIcon aria-hidden="true" />
  </button>
</header>

<MobileMenu />

<script>
  // Шапка закреплена: прячется при скролле вниз, выезжает при скролле вверх
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const THRESHOLD = 8; // мелкие движения не дёргают шапку
    let lastY = scrollY;
    let ticking = false;

    const update = () => {
      const y = scrollY;
      const delta = y - lastY;
      if (y <= header.offsetHeight) header.classList.remove('is-hidden');
      else if (delta > THRESHOLD) header.classList.add('is-hidden');
      else if (delta < -THRESHOLD) header.classList.remove('is-hidden');
      if (Math.abs(delta) > THRESHOLD || y <= header.offsetHeight) lastY = y;
      ticking = false;
    };

    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );

    // Фокус с клавиатуры возвращает спрятанную шапку
    header.addEventListener('focusin', () => header.classList.remove('is-hidden'));
  }
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-12) var(--container-pad);
    /* шапка прозрачная — клики проходят сквозь пустое место */
    pointer-events: none;
    transition: opacity 200ms ease-out;
  }

  .header > :global(*) {
    pointer-events: auto;
  }

  .header.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .header.is-hidden > :global(*) {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .header {
      transition:
        translate 300ms cubic-bezier(0.2, 0, 0, 1),
        opacity 300ms cubic-bezier(0.2, 0, 0, 1);
    }

    .header.is-hidden {
      translate: 0 -100%;
    }
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .header__burger {
    display: none;
  }

  @media (max-width: 767px) {
    .header__nav {
      display: none;
    }

    .header__burger {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 32px;
      background: var(--color-surface-secondary);
      color: var(--color-element-primary);
      -webkit-tap-highlight-color: transparent;
      transition: scale 150ms ease-out;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .header__burger:active {
      scale: 0.96;
    }
  }

</style>
