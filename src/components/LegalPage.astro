---
/**
 * Юридическая страница (политика, согласие): крошки «Главная / название», заголовок и текст в колонке 688,
 * как первый экран статьи. Пока документа нет — заглушка: страница закрыта от индексации (noindex)
 * и не попадает в sitemap (фильтр в astro.config.mjs). Когда появится текст — передать его в слот
 * и снять draft.
 */
import Base from '../layouts/Base.astro';
import Crumbs from './article/Crumbs.astro';
import Button from './Button.astro';
import { EMAIL } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** документ ещё не готов: заглушка, noindex */
  draft?: boolean;
}

const { title, description, draft = false } = Astro.props;
---

<Base title={`${title} — Скоуп`} description={description} noindex={draft}>
  <main class="legal container">
    <div class="legal__column">
      <Crumbs title={title} />
      <h1 class="t-h3">{title}</h1>
      {
        draft ? (
          <div class="legal__draft">
            <p class="t-body-l legal__muted">
              Документ готовится и скоро появится на этой странице. Если есть вопросы об обработке данных — напишите
              {'на\u00a0'}<a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
            </p>
            <Button variant="primary" href="/">На главную</Button>
          </div>
        ) : (
          <div class="legal__text t-body-l">
            <slot />
          </div>
        )
      }
    </div>
  </main>
</Base>

<style>
  .legal {
    padding-block: var(--space-32) var(--layout-section-padding);
    min-height: 100vh;
    min-height: 100svh;
  }

  .legal__column {
    display: flex;
    flex-direction: column;
    gap: var(--space-44);
    max-width: var(--layout-column-width);
    margin-inline: auto;
  }

  .legal__draft {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-l);
  }

  .legal__muted {
    color: var(--color-text-secondary);
  }

  .legal__muted a {
    color: var(--color-text-primary);
    transition: color 150ms ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .legal__muted a:hover {
      color: var(--color-text-secondary);
    }
  }

  @media (max-width: 767px) {
    .legal {
      padding-top: var(--space-20);
    }

    .legal__draft {
      align-items: stretch;
    }
  }
</style>
