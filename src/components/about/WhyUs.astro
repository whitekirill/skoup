---
/**
 * «Почему мы» (Figma: desktop 524:29099, mobile 536:3480).
 * Абзац H2 обычным текстом с халфтон-иконками в строке (лупа, молния) — переносится на любой ширине,
 * заливается по словам вместе со скроллом. Под ним — лента шотов из кейсов (542:33345): едет влево вместе
 * со скроллом, шоты с разной высотой — с лёгким параллаксом, при резком скролле лента растягивается
 * и пружиной собирается (src/scripts/shots-drift.ts).
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import loupe from '../../assets/about/loupe.svg?url';
import bolt from '../../assets/about/bolt.svg?url';
import { SHOTS } from '../../data/about';

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/about/shots/*.png', { eager: true });
const shots = await Promise.all(
  SHOTS.map(async (shot) => {
    const src = files[`../../assets/about/shots/${shot.file}`].default;
    // 1x и 2x от размера в макете; мобильная лента меньше — браузер возьмёт 1x
    const widths = [Math.round(shot.width), Math.round(shot.width * 2)];
    const build = (format: 'avif' | 'webp') =>
      Promise.all(widths.map((width) => getImage({ src, width, format }))).then((images) =>
        images.map((image, i) => `${image.src} ${widths[i]}w`).join(', '),
      );
    const [avif, webp] = await Promise.all([build('avif'), build('webp')]);
    const fallback = await getImage({ src, width: widths[0], format: 'webp' });
    // на мобильном лента — 0.7 от макета (см. --u ниже)
    const sizes = `(max-width: 767px) ${Math.round(shot.width * 0.7)}px, ${Math.round(shot.width)}px`;
    return { ...shot, avif, webp, sizes, fallback: fallback.src };
  }),
);
---

<section class="why" aria-labelledby="why-title">
  <div class="why__head container">
    <h2 class="why__label t-h4" id="why-title">Почему мы?</h2>
    <p class="why__text t-h2">
      Делаем финтех удобным. Требования закладываем с&nbsp;первого макета. Работаем внутри вашей команды. Решения
      принимаем{' '}<span class="why__keep"><span class="why__icon why__icon--loupe" aria-hidden="true"><img src={loupe} alt="" width="113" height="79" /></span>{' '}<span class="accent-4">на</span></span><span class="accent-4">{' '}данных <span class="why__tight">и&nbsp;исследованиях,</span></span>{' '}
      и делаем это <span class="why__tight">со&nbsp;вкусом.</span> Не тянем <span class="why__tight">с&nbsp;решениями,</span> даём{' '}<span class="accent-3"><span class="why__keep">результат{' '}<span class="why__icon why__icon--bolt" aria-hidden="true"><img src={bolt} alt="" width="84" height="84" /></span></span>{' '}быстро.</span>
    </p>
  </div>

  <div class="shots" data-shots>
    <ul class="shots__track" aria-label="Шоты из кейсов">
      {
        shots.map((shot) => (
          <li class="shots__item" style={`--w: ${shot.width}; --h: ${shot.height};`}>
            <picture>
              <source type="image/avif" srcset={shot.avif} sizes={shot.sizes} />
              <source type="image/webp" srcset={shot.webp} sizes={shot.sizes} />
              <img src={shot.fallback} alt={shot.alt} width={Math.round(shot.width)} height={Math.round(shot.height)} loading="lazy" decoding="async" />
            </picture>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { mountScrollFill } from '../../scripts/scroll-fill';
  import { mountShotsDrift } from '../../scripts/shots-drift';
  const text = document.querySelector<HTMLElement>('.why__text');
  if (text) mountScrollFill(text);
  const shots = document.querySelector<HTMLElement>('[data-shots]');
  if (shots) mountShotsDrift(shots);
</script>

<style>
  .why {
    padding-block: var(--layout-section-padding);
  }

  .why__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-l);
  }

  .why__label {
    color: var(--color-text-secondary);
  }

  /*
   * В макете строки идут с шагом «высота строки + 8» (ряды с зазором 8). Лишние 4 px сверху и снизу
   * абзаца компенсируем отрицательными полями — верх и низ текста совпадают с макетом.
   */
  .why__text {
    --icon: var(--typography-h2-line-height);
    max-width: 896px;
    margin-block: calc(-1 * var(--space-4));
    line-height: calc(var(--typography-h2-line-height) + var(--space-8));
    /* В макете слова — блоки с зазором gap-3xs; пробел Manrope — 0.2em, текстовые слои Figma шире
       браузерных на 2.25 × |letter-spacing| (как в WordsHeading) */
    word-spacing: calc(var(--gap-3xs) - 0.2em - 2.25 * var(--typography-h2-letter-spacing));
  }

  .accent-4 {
    --fill-color: var(--color-text-accent-4);
    color: var(--color-text-accent-4);
  }

  .accent-3 {
    --fill-color: var(--color-text-accent-3);
    color: var(--color-text-accent-3);
  }

  /*
   * Заливка по скроллу (src/scripts/scroll-fill.ts): слово из серого text/secondary переходит в свой цвет —
   * --fill-color родителя. Иконки проявляются из серого вместе со словами.
   */
  .why__text {
    --fill-color: var(--color-text-primary);
  }

  .why__text:global(.is-filling) :global(.fill-word) {
    color: color-mix(in oklab, var(--fill-color) calc(var(--fill, 0) * 100%), var(--color-text-secondary));
  }

  .why__text:global(.is-filling) :global(.why__icon.fill-word) {
    opacity: calc(0.4 + 0.6 * var(--fill, 0));
    filter: grayscale(calc(1 - var(--fill, 0)));
  }

  /* фразы, которые в макете — один текстовый слой: обычный пробел внутри */
  .why__tight {
    word-spacing: normal;
  }

  /* иконка не отрывается от соседнего слова */
  .why__keep {
    white-space: nowrap;
  }

  /*
   * Иконка — квадрат высотой в строку, по центру строки. Точки (слой Dots из Figma) выходят за квадрат,
   * как в макете: смещения и размеры — доли стороны квадрата (56 на desktop, 38 на mobile).
   */
  .why__icon {
    position: relative;
    display: inline-block;
    width: var(--icon);
    height: var(--icon);
    margin-top: var(--space-4);
    vertical-align: top;
  }

  .why__icon img {
    position: absolute;
    max-width: none;
    pointer-events: none;
  }

  .why__icon--loupe img {
    top: calc(var(--icon) * -0.17);
    left: calc(var(--icon) * -0.1636);
    width: calc(var(--icon) * 2.025);
    height: calc(var(--icon) * 1.4143);
  }

  .why__icon--bolt img {
    top: calc(var(--icon) * -0.25);
    left: calc(var(--icon) * 0.0455);
    width: calc(var(--icon) * 1.5);
    height: calc(var(--icon) * 1.5);
  }

  /*
   * Лента шотов: от левого поля страницы до правого края окна и дальше (обрезается).
   * Размеры шотов — из макета (px) × --u: 1 px на 1440, к 393 — 0.7 px (мобильной ленты в макете пока нет).
   * Между шотами — 2/3 от space-32 (32 × 2/3 px), как в макете: лента там уменьшена до 2/3.
   */
  .shots {
    --u: clamp(0.7px, 0.5874px + 0.02865vw, 1px);
    margin-top: calc(var(--layout-section-padding) + var(--space-44));
    padding-left: var(--container-pad);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .shots::-webkit-scrollbar {
    display: none;
  }

  /* лентой управляет скрипт — своей прокрутки нет */
  .shots:global(.is-drifting) {
    overflow-x: clip;
  }

  .shots__track {
    display: flex;
    align-items: flex-start;
    gap: calc(32 * 2 / 3 * var(--u));
    width: max-content;
    padding-right: var(--container-pad);
  }

  .shots__item {
    flex: none;
    width: calc(var(--w) * var(--u));
    height: calc(var(--h) * var(--u));
  }

  .shots__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 767px) {
    .why__head {
      gap: var(--space-32);
    }
  }
</style>
