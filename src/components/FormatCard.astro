---
/**
 * Format card (Figma 592:12994): Icon, Title, Description, Time, Payment. Статичная.
 */
import Icon, { type IconName } from './Icon.astro';
import type { IconColor } from './ServiceCard.astro';

interface Props {
  icon: IconName;
  color: IconColor;
  title: string;
  description: string;
  time: string;
  payment: string;
}

const { icon, color, title, description, time, payment } = Astro.props;
---

<article class="format">
  <div class="format__top">
    <Icon name={icon} size={32} class={`icon-${color}`} />
    <div class="format__text">
      <h3 class="format__title t-body-l">{title}</h3>
      <p class="format__secondary t-body-s">{description}</p>
    </div>
  </div>
  <div class="format__bottom">
    <p class="t-button-l">{time}</p>
    <p class="format__secondary t-caption">{payment}</p>
  </div>
</article>

<style>
  .format {
    display: flex;
    flex-direction: column;
    gap: var(--gap-l);
    padding: var(--space-24);
    border-radius: var(--radius-24);
    background: var(--color-static-white);
  }

  .format__top {
    display: flex;
    flex-direction: column;
    gap: var(--gap-s);
  }

  .format__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .format__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--gap-4xs);
  }

  .format__secondary {
    color: var(--color-text-secondary);
  }

  /* на мобильном заголовок на ступень крупнее — Header/H5 (20 / 26) */
  @media (max-width: 767px) {
    .format__title {
      font-size: var(--typography-h5-size);
      line-height: var(--typography-h5-line-height);
      letter-spacing: var(--typography-h5-letter-spacing);
    }
  }
</style>
