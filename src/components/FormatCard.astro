---
/** FormatCard (Figma 411:9699): Illustration, Title, Description, Terms, Payment */

interface Props {
  title: string;
  description: string;
  terms: string;
  payment: string;
  illustration: string;
  /** Сдвиг точек внутри рамки иллюстрации, как в макете (доля ширины) */
}

const { title, description, terms, payment, illustration } = Astro.props;
---

<article class="format">
  <div class="format__top">
    <img class="format__illustration" src={illustration} alt="" width="132" height="132" loading="lazy" decoding="async" />
    <h3 class="t-h3">{title}</h3>
    <p class="format__description t-body-m">{description}</p>
  </div>
  <div class="format__bottom">
    <p class="t-button-xl">{terms}</p>
    <p class="format__payment t-caption">{payment}</p>
  </div>
</article>

<style>
  .format {
    display: flex;
    flex-direction: column;
    gap: var(--size-format-gap);
    padding: var(--size-format-padding);
    background: var(--color-surface-primary);
  }

  .format__top {
    display: flex;
    flex-direction: column;
    gap: var(--gap-s);
  }

  /* 132 → 100 на мобильном; SVG прибит к левому верхнему углу (xMinYMin) */
  .format__illustration {
    width: var(--size-format-illustration);
    height: var(--size-format-illustration);
  }

  .format__description,
  .format__payment {
    color: var(--color-text-secondary);
  }

  .format__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--gap-4xs);
  }
</style>
