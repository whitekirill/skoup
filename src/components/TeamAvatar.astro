---
/**
 * Team avatar (Figma 632:7881). Breakpoint: Desktop 64 / Mobile 48; State: Default / Hover; Name, Role.
 * Desktop: при наведении фото поднимается на 16 px с тенью Shadow/Floating, сверху проявляются имя и роль.
 * Mobile и тач — без наведения и без подписи (имя остаётся в alt).
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  name: string;
  role: string;
  photo: ImageMetadata;
}

const { name, role, photo } = Astro.props;
---

<div class="avatar">
  <Image class="avatar__photo" src={photo} alt={`${name}, ${role}`} width={64} height={64} densities={[1, 2, 3]} loading="lazy" />
  <p class="avatar__label t-body-xs" aria-hidden="true">
    <span class="avatar__name">{name}</span>
    <span class="avatar__role">{role}</span>
  </p>
</div>

<style>
  .avatar {
    /* обводка 3 px в макете — токена такой толщины нет */
    --avatar-size: var(--space-64);
    --avatar-border: 3px;
    position: relative;
    flex-shrink: 0;
    width: var(--avatar-size);
    height: var(--avatar-size);
  }

  .avatar__photo {
    width: 100%;
    height: 100%;
    border: var(--avatar-border) solid var(--color-surface-primary);
    border-radius: var(--radius-full);
    object-fit: cover;
    background: var(--color-surface-secondary);
  }

  .avatar__label {
    position: absolute;
    bottom: 100%;
    left: 50%;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: var(--space-160);
    translate: -50% 0;
    text-align: center;
    opacity: 0;
    pointer-events: none;
  }

  .avatar__role {
    color: var(--color-text-secondary);
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 768px) {
    .avatar__photo,
    .avatar__label {
      transition-property: translate, opacity, box-shadow;
      transition-duration: 200ms;
      transition-timing-function: ease-out;
    }

    .avatar:hover {
      z-index: 1;
    }

    .avatar:hover .avatar__photo {
      translate: 0 calc(-1 * var(--space-16));
      box-shadow: var(--effect-shadow-floating);
    }

    .avatar:hover .avatar__label {
      translate: -50% calc(-1 * var(--gap-xs));
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .avatar:hover .avatar__photo {
      translate: none;
    }

    .avatar:hover .avatar__label {
      translate: -50% 0;
    }
  }

  @media (max-width: 767px) {
    .avatar {
      --avatar-size: var(--space-48);
    }

    .avatar__label {
      display: none;
    }
  }
</style>
