---
/**
 * Button (Figma 31:15794, внутренний .Button 31:15826).
 * Type: Primary / Secondary / Inverse / Navbutton × State: Default / Hover / Focus / Disabled.
 * Всегда пилюля (radius/full). Высота и минимальная ширина — size/button/height (60 / 52):
 * кнопка с одной иконкой квадратная. Вертикальный отступ — size/button/padding-y.
 * Обводок нет ни в одном состоянии: hover, фокус и нажатие — кнопка чуть прозрачнее (opacity 0.8).
 * Иконки (iconLeft / iconRight — Amicons) всегда цвета текста кнопки.
 */
import type { HTMLAttributes } from 'astro/types';
import Icon, { type IconName } from './Icon.astro';

type Variant = 'primary' | 'secondary' | 'inverse' | 'nav';

interface Props extends HTMLAttributes<'a'> {
  variant?: Variant;
  href?: string;
  /** Растянуть на всю ширину контейнера */
  block?: boolean;
  disabled?: boolean;
  /** Декоративная кнопка внутри кликабельной карточки (span вместо a/button) */
  as?: 'span';
  /** Для кнопки отправки формы */
  type?: 'button' | 'submit';
  iconLeft?: IconName;
  iconRight?: IconName;
  /** Подпись для кнопки только с иконкой */
  label?: string;
}

const { variant = 'primary', href, block = false, disabled = false, as, type = 'button', iconLeft, iconRight, label, class: className, ...rest } = Astro.props;
const Tag = as ?? (href && !disabled ? 'a' : 'button');
const hasText = Astro.slots.has('default');
const classes = ['btn', `btn--${variant}`, variant === 'nav' ? 't-button-s' : 't-button-l', block && 'btn--block', !hasText && 'btn--icon-only', className];
---

<Tag
  class:list={classes}
  href={Tag === 'a' ? href : undefined}
  type={Tag === 'button' ? type : undefined}
  disabled={Tag === 'button' && disabled ? true : undefined}
  aria-disabled={Tag !== 'button' && disabled ? 'true' : undefined}
  aria-label={label}
  {...rest}
>
  {iconLeft && <Icon name={iconLeft} />}
  {hasText && <span class="btn__text"><slot /></span>}
  {iconRight && <Icon name={iconRight} />}
</Tag>

<style>
  .btn {
    --btn-height: var(--size-button-height);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-width: var(--btn-height);
    height: var(--btn-height);
    padding: var(--size-button-padding-y) var(--gap-3xs);
    border-radius: var(--radius-full);
    white-space: nowrap;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition-property: color, background-color, opacity, scale;
    transition-duration: 150ms;
    transition-timing-function: ease-out;
  }

  .btn__text {
    padding-inline: var(--space-8);
  }

  .btn--icon-only {
    padding-inline: 0;
  }

  .btn--block {
    display: flex;
    width: 100%;
  }

  .btn--primary {
    background: var(--color-surface-primary-inversion);
    color: var(--color-text-primary-inversion);
  }

  .btn--secondary {
    background: var(--color-surface-secondary);
    color: var(--color-text-primary);
  }

  .btn--inverse {
    background: var(--color-surface-primary);
    color: var(--color-text-primary);
  }

  .btn--nav {
    padding-inline: var(--space-8);
    background: var(--color-surface-tertiary);
    color: var(--color-text-primary);
  }

  /* Hover, фокус с клавиатуры и нажатие — кнопка чуть прозрачнее, фон не меняется. Без обводки */
  .btn:focus-visible,
  .btn:active {
    opacity: 0.8;
  }

  @media (hover: hover) and (pointer: fine) {
    .btn:hover {
      opacity: 0.8;
    }
  }

  .btn:focus-visible {
    outline: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .btn:not(:disabled, [aria-disabled='true']):active {
      scale: 0.96;
    }
  }

  .btn:disabled,
  .btn[aria-disabled='true'] {
    opacity: 0.5;
    color: var(--color-text-secondary);
    cursor: default;
    pointer-events: none;
  }
</style>
